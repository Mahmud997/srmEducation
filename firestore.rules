rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPERS ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return isSignedIn() ? userDoc().role : null;
    }

    function isDirector() {
      return role() == "director";
    }

    function isManager() {
      return role() == "manager";
    }

    function isTeacher() {
      return role() == "teacher";
    }

    function isStudent() {
      return role() == "student";
    }

    function isAdmin() {
      return isDirector() || isManager();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ========== USERS ==========
    match /users/{userId} {
      allow read: if isDirector() || isManager() || isOwner(userId);
      allow create: if isDirector() || isManager();
      allow update: if isDirector() ||
                       (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["role", "salaryType", "salaryPercent", "fixedRate"]));
      allow delete: if isDirector();
    }

    // ========== GROUPS ==========
    match /groups/{groupId} {
      allow read: if isAdmin() ||
                     (isTeacher() && resource.data.teacherIds.hasAny([request.auth.uid])) ||
                     (isStudent() && resource.data.studentIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    // ========== LESSONS ==========
    match /lessons/{lessonId} {
      allow read: if isAdmin() ||
                     (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                     (isStudent() && 
                      get(/databases/$(database)/documents/groups/$(resource.data.groupId))
                        .data.studentIds.hasAny([request.auth.uid]));

      allow create: if isAdmin() ||
                       (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update: if isAdmin() ||
                       (isTeacher() && resource.data.teacherId == request.auth.uid);

      allow delete: if isDirector();

      // Subcollection attendance
      match /attendance/{studentId} {
        allow read: if isAdmin() ||
                       (isTeacher() && 
                        get(/databases/$(database)/documents/lessons/$(lessonId)).data.teacherId == request.auth.uid) ||
                       isOwner(studentId);

        // Создание/изменение attendance лучше через Cloud Functions
        allow create, update: if isAdmin() ||
                                 (isTeacher() && 
                                  get(/databases/$(database)/documents/lessons/$(lessonId)).data.teacherId == request.auth.uid);
        allow delete: if isDirector();
      }
    }

    // ========== QR SESSIONS ==========
    match /qrSessions/{sessionId} {
      allow read: if isSignedIn();
      // Создание и изменение только через Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // ========== REPORTS ==========
    match /reports/{reportId} {
      allow read: if isAdmin() ||
                     (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin() ||
                       (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isDirector();
    }

    // ========== PAYMENTS ==========
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
                     (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.toUserIds.hasAny([request.auth.uid]) ||
                      (resource.data.toRoles != null && resource.data.toRoles.hasAny([role()])));
      allow update: if isSignedIn() && 
                       resource.data.toUserIds.hasAny([request.auth.uid]) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
      allow create, delete: if isAdmin(); // или только через Functions
    }

    // ========== SALARY ==========
    match /salaryCalculations/{calcId} {
      allow read: if isDirector() ||
                     (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isDirector();
    }
  }
}